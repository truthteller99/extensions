{
  "name": "Motchill Custom Repo",
  "description": "Direct Ad-Block Bypassing Streams for Motchill",
  "manifestVersion": 2,
  "pluginVersion": 1,
  "plugins": [
    {
      "name": "Motchill",
      "id": "com.example.motchill",
      "version": 1,
      "authors": ["Custom"],
      "lang": "vi",
      "mainUrl": "https://motchillc.com",
      "types": ["Movie", "TvSeries", "Anime"],
      "searchUrl": "https://motchillc.com",
      "selectors": {
        "searchItems": "li.list-film-item",
        "title": "h3",
        "url": "a[href]",
        "poster": "img[src]",
        "quality": ".label",
        "plot": ".film-content p",
        "episodeLink": ".list-episode a",
        "videoStreamRegex": "file:\\s*[\"'](https.*?\\.m3u8.*?)[\"']"
      }
    }
  ]
}
